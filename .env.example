# Red.ly Desktop - variables de entorno (ejemplo)
# Copia este archivo a .env y ajusta los valores si hace falta.
# No coloques secretos: este proyecto no usa claves ni cuentas.

TIKVID_BASE_URL=https://tikvid.io
TIKVID_AJAX_SEARCH_URL=https://tikvid.io/api/ajaxSearch

# Fuente de listados de perfil (lote). Misma familia de producto que TikVid.
SAVETIK_BASE_URL=https://savetikpro.com
SAVETIK_AJAX_SEARCH_URL=https://savetikpro.com/api/ajaxSearch
SAVETIK_HOME_PATH=/en
SAVETIK_LANG=en

REQUEST_TIMEOUT=30
DOWNLOAD_TIMEOUT=120
MAX_REDIRECTS=5

RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=0.8

DOWNLOAD_DIRECTORY=downloads

# Lote / descarga en masa
MANIFEST_PATH=downloads/manifest.json
BATCH_DELAY_SECONDS=1.0
BATCH_PAGE_DELAY_SECONDS=1.0
BATCH_MAX_PAGES=100
# 0 = sin límite (la CLI se limita con --max; la GUI usa un tope propio)
BATCH_DEFAULT_MAX_VIDEOS=0
